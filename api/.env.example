# API environment template (safe placeholders only)
# Use real secrets in your deployment platform secret manager.

APP_ENV=development
DEV_MODE=true

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cbs_match
QUESTIONS_PATH=/Users/thomascline/Desktop/cbs-match/questions.json
MIGRATIONS_DIR=

# Required in staging/production: 32+ random chars
JWT_SECRET=replace-with-32-plus-char-random-secret

# Required in staging/production: long random token
ADMIN_TOKEN=replace-with-long-random-admin-token
ADMIN_BOOTSTRAP_EMAIL=admin@cbsmatch.local
ADMIN_BOOTSTRAP_PASSWORD=community123
ADMIN_SESSION_TTL_MINUTES=480

# Comma-separated origins. No wildcard in staging/production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
VERIFICATION_TOKEN_TTL_HOURS=24

MATCH_EXPIRY_HOURS=72
MATCH_TIMEZONE=America/New_York
LOOKBACK_WEEKS=6
MIN_SCORE=0.60
MATCH_TOP_K=60
MATCH_ALGO_MODE=stable_bipartite_if_possible

VALUES_W=0.22
EMO_STAB_W=0.12
ATTACH_W=0.22
CONFLICT_W=0.24
PERSONALITY_W=0.12
LIFE_W=0.08
ESCALATION_GATE=0.95
ESCALATION_PENALTY_THRESHOLD=0.70
ESCALATION_PENALTY_MULTIPLIER=0.75
WITHDRAWAL_PENALTY_THRESHOLD=0.70
WITHDRAWAL_PENALTY_MULTIPLIER=0.85
MISMATCH_PENALTY_MULTIPLIER=0.80
# MATCHING_CONFIG_JSON={"VALUES_W":0.22}

RL_AUTH_REGISTER_LIMIT=100
RL_AUTH_LOGIN_LIMIT=100
RL_AUTH_VERIFY_EMAIL_LIMIT=100
RL_AUTH_REFRESH_LIMIT=120
RL_SESSION_ANSWERS_LIMIT=120
RL_MATCH_ACCEPT_LIMIT=100
RL_MATCH_DECLINE_LIMIT=100
RL_MATCH_FEEDBACK_LIMIT=100
RL_WINDOW_SECONDS=60
