# Web environment template (safe placeholders only)
# NEXT_PUBLIC_* vars are bundled to the browser.

NODE_ENV=development

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000

# Server-only fallback for admin API routes.
# Do not expose an admin token in NEXT_PUBLIC_* env vars.
ADMIN_TOKEN=dev-admin-token-for-local-only
